VITE_API_BASE_URL=https://myticket-api.kat-jr.com/api/v1/scanner

# Required for auth + scanner integration/E2E tests
TEST_SCANNER_EMAIL=
TEST_SCANNER_PASSWORD=

# Optional — enables positive scan integration test (may mark ticket used on one_time events)
TEST_TICKET_CODE=

# Optional — override auto-picked assignment event id
TEST_EVENT_ID=

# ar | en — mirrors frontend Accept-Language header
TEST_ACCEPT_LANGUAGE=en
